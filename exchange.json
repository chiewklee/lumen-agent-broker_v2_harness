{
  "main": "agent-network.yaml",
  "name": "lumen-agent-broker-v2-harness",
  "classifier": "agentic-network",
  "organizationId": "<your-org-id>",
  "descriptorVersion": "1.0.0",
  "tags": [],
  "groupId": "<your-org-id>",
  "assetId": "lumen-agent-broker-v2-harness",
  "version": "1.0.0",
  "description": "Lumen agent network (2.0, harness). Multi-node broker: classifies the request, always runs network diagnostics on reported downtime, gathers billing and recommendations read-only, offers field service slots and books only the slot the customer selects.",
