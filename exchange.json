    {
      "groupId": "<your-org-id>",
      "assetId": "billingAgent",
      "version": "1.0.0",
      "classifier": "agent-metadata",
      "packaging": "zip"
    },
    {
      "groupId": "<your-org-id>",
      "assetId": "networkDiagnosticAgent",
      "version": "1.0.0",
      "classifier": "agent-metadata",
      "packaging": "zip"
    },
    {
      "groupId": "<your-org-id>",
      "assetId": "solutionAdvisorAgent",
      "version": "1.0.0",
      "classifier": "agent-metadata",
      "packaging": "zip"
    },
    {
      "groupId": "<your-org-id>",
      "assetId": "googleGemini",
      "version": "1.0.0",
      "classifier": "llm-metadata",
      "packaging": "zip"
    }
  ],
  "metadata": {
    "variables": {
      "fieldServiceMcpServer": {
        "url": {
          "description": "fieldServiceMcpServer URL",
          "default": "https://<field-service-mcp-server-url>",
          "secret": false
        }
      },
      "networkDiagnosticAgent": {
        "url": {
          "description": "networkDiagnosticAgent URL",
          "default": "https://<network-diagnostic-agent-url>",
          "secret": false
        }
      },
      "solutionAdvisorAgent": {
        "url": {
          "description": "solutionAdvisorAgent URL",
          "default": "https://<solution-advisor-agent-url>",
          "secret": false
        }
      },
      "billingAgent": {
        "url": {
          "description": "billing Agent URL",
          "default": "https://<billing-agent-url>",
          "secret": false
        }
      },
      "googleGemini": {
        "url": {
          "description": "Google Gemini API URL",
          "default": "https://generativelanguage.googleapis.com/",
          "secret": false
        },
        "modelName": {
          "description": "Google Gemini Model Name",
          "default": "gemini-3.8-flash",
          "secret": false
        },
        "apiKey": {
          "description": "Google Gemini API key",
          "secret": true
        }
      }
    }
  },
  "apiVersion": "v1"
}
